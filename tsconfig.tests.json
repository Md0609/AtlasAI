{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "**/src/**/*.ts",
    "**/test/**/*.ts",
    "services/signal-engine/golden/**/*.ts",
    "evals/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "apps/web/**"
  ]
}
