{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/config",
    "packages/contracts",
    "packages/domain",
    "packages/schema",
    "packages/bus",
    "packages/dataplane",
    "packages/relevance",
    "packages/portfolio-core",
    "services/intelligence/guard",
    "services/intelligence/egress",
    "services/intelligence/runtime",
    "services/intelligence/agents",
    "services/workers",
    "services/ingest",
    "services/signal-engine",
    "apps/api",
    "apps/web",
    "ops"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build -w apps/web",
    "test": "tsc -b tsconfig.build.json && tsc -p tsconfig.tests.json && vitest run",
    "migrate": "node packages/schema/dist/cli.js up",
    "ingest": "node services/ingest/dist/cli.js run",
    "api": "node apps/api/dist/index.js",
    "quality-report": "node ops/dist/quality-report.js",
    "workers": "node services/workers/dist/cli.js drain",
    "test:only": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "@types/node": "^22.10.0"
  }
}
