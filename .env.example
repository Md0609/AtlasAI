# Atlas — environment
#
# Copy to .env for reference; nothing loads this file automatically (there is no
# dotenv dependency), so these are the variables your process manager must set.
#
# "dev default" means the value used when the variable is absent OUTSIDE
# production. In production, anything marked REQUIRED makes the process refuse
# to start rather than fall back — see packages/config and apps/api/src/index.ts.
#
# Invalid values never become a default. A non-numeric integer, an unparseable
# boolean or a non-postgres URL is a startup failure, not NaN / false / a guess.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Enables production behaviour: required config, Secure cookies, HSTS.
NODE_ENV=development

# REQUIRED in production. Must be a postgres:// or postgresql:// URL.
# Refuses to start in production if it equals the published development URL
# below — those credentials are in this repository.
# dev default: postgres://atlas:atlas@127.0.0.1:5432/atlas
ATLAS_DATABASE_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas

# Integration tests only. Never used by a running server.
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas_test

# Connection pool size, per process. API + workers + ingest share the server's
# max_connections, so raise deliberately. dev default: 10 (1-100)
ATLAS_DB_POOL_MAX=10

# HTTP port. dev default: 3000 (1-65535)
PORT=3000

# ---------------------------------------------------------------------------
# Intelligence plane
# ---------------------------------------------------------------------------

# REQUIRED in production. One of: fixture | anthropic
# An unrecognised value is an error EVERYWHERE, including development — a typo
# used to select the deterministic mock silently, and its output is
# indistinguishable from reasoned analysis by the time a user sees it.
# `fixture` in production is allowed but must be explicit; it is a demo mode.
# dev default: fixture
ATLAS_LLM_PROVIDER=fixture

# Required only when ATLAS_LLM_PROVIDER=anthropic. The provider throws on first
# use if it is missing, rather than degrading silently.
# ANTHROPIC_API_KEY=

# Per-call ceiling. Deliberately well inside the 300s job lease so a slow turn
# degrades to the deterministic template instead of losing its job.
# dev default: 30000 (>= 1; any positive value is a choice, 0 and negatives are bugs)
ATLAS_LLM_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Sets the session cookie's Secure flag AND enables HSTS — one signal, because
# a Secure cookie without HSTS and HSTS without a Secure cookie are each half a
# control. Accepts true/false/1/0/yes/no/on/off, case-insensitive; anything else
# is an error. Defaults to true in production, false otherwise.
# ATLAS_COOKIE_SECURE=true

# Per-IP limits on the credential endpoints, the brute-force surface.
# NOTE: the store is in-memory and trustProxy is unset, so behind a load
# balancer these collapse into one global bucket. See P1-16 in
# docs/private-beta-remediation.md — that fix waits on the deployment decision.
# dev defaults: 20 per 15 min, 10 per hour (both >= 1, no ceiling — a very large
# value is a deliberate "effectively unlimited")
ATLAS_RATE_LIMIT_LOGIN=20
ATLAS_RATE_LIMIT_REGISTER=10

# Bearer token for GET /metrics. Unset means the endpoint returns 404, so a
# scraper misconfiguration is indistinguishable from the endpoint not existing;
# production logs a warning when it is absent.
# ATLAS_METRICS_TOKEN=

# ---------------------------------------------------------------------------
# GDPR
# ---------------------------------------------------------------------------

# Grace period before a requested erasure runs. Bounded to 0-30. The ceiling is
# the Art. 17 SLA the certificate promises the user. 0 is allowed — "erase
# immediately" is a legitimate explicit choice — while an EMPTY value reads as
# absent and falls back to 30, which is the silent case that used to schedule
# an immediate deletion. Negatives and junk are refused outright.
# dev default: 30
ATLAS_ERASURE_GRACE_DAYS=30

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# `off` disables logging entirely — used by the test suite, never in production.
# ATLAS_LOG=off

# pino level. dev default: info
ATLAS_LOG_LEVEL=info

# Where the ingest CLI writes quality reports.
# dev default: <cwd>/ops/reports
# ATLAS_REPORTS_DIR=
